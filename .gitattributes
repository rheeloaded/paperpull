# Line endings matter here, in one direction each.
#
# A shell script with CRLF line endings fails on macOS and Linux with a
# confusing "bad interpreter: /usr/bin/env bash^M", so the .command and .sh
# launchers must always check out with LF - including on Windows, where git
# would otherwise convert them.
#
# Windows .bat files want the opposite: CRLF.

* text=auto

*.command   text eol=lf
*.sh        text eol=lf
*.bat       text eol=crlf
*.cmd       text eol=crlf

*.py        text
*.md        text
*.json      text
*.txt       text
*.toml      text

*.pdf       binary
*.png       binary
*.gif       binary
*.whl       binary
*.zip       binary
