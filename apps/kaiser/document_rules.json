{
  "statement_rules": [
    {
      "pattern": "\\bpremium bills\\b",
      "summary": "Premium Bill"
    },
    {
      "pattern": "^medical bill$",
      "summary": "Medical Bill"
    },
    {
      "pattern": "\\bmedical (?:billing statements?|bills?)\\b",
      "summary": "Medical Bill"
    }
  ],
  "tax_rules": [
    {
      "pattern": "\\b1095(?:-[A-C])?\\b",
      "summary": "Tax Form 1095"
    }
  ],
  "insurance_rules": [
    {
      "pattern": "\\b(?:explanations? of benefits|EOB)\\b",
      "summary": "Explanation of Benefits"
    }
  ],
  "skip_patterns": []
}
