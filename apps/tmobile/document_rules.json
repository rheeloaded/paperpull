{
  "_comment": "Editable rules mapping T-Mobile document titles to filename summaries. Checked in order: tax, then insurance (unused), then statement. T-Mobile issues monthly bills and little else, so the statement rules do the work. Repair after running diagnose against your real bill-history page.",
  "tax_rules": [
    {"pattern": "\\b1099\\b", "summary": "1099 Tax Form"},
    {"pattern": "tax\\s+(document|form|statement|package|information|center)", "summary": "Tax Document"}
  ],
  "insurance_rules": [],
  "statement_rules": [
    {"pattern": "monthly\\s+(account\\s+)?(statement|bill)", "summary": "Monthly Statement"},
    {"pattern": "detailed\\s+bill|summary\\s+bill", "summary": "Monthly Statement"},
    {"pattern": "account\\s+statement", "summary": "Account Statement"},
    {"pattern": "\\b(bill|invoice|statement)\\b", "summary": "Monthly Statement"}
  ],
  "skip_patterns": [
    "payment\\s+(receipt|confirmation|history)",
    "autopay",
    "paperless",
    "customer\\s+agreement",
    "terms\\s+of\\s+service",
    "privacy\\s+(notice|policy)",
    "marketing",
    "\\boffers?\\b",
    "\\bdeals?\\b",
    "usage\\s+(details|summary)"
  ]
}
