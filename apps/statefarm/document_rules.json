{
  "_comment": "Editable rules mapping State Farm document titles to filename summaries. Checked in order: tax, then insurance, then statement. Repair after running diagnose against the real documents page.",
  "tax_rules": [
    {
      "pattern": "1099-?INT\\b",
      "summary": "1099-INT Tax Form"
    },
    {
      "pattern": "1099-?DIV\\b",
      "summary": "1099-DIV Tax Form"
    },
    {
      "pattern": "1099-?B\\b",
      "summary": "1099-B Tax Form"
    },
    {
      "pattern": "1099-?R\\b",
      "summary": "1099-R Tax Form"
    },
    {
      "pattern": "\\b1099\\b",
      "summary": "1099 Tax Form"
    },
    {
      "pattern": "\\b1098\\b",
      "summary": "1098 Tax Form"
    },
    {
      "pattern": "\\b5498\\b",
      "summary": "5498 Tax Form"
    },
    {
      "pattern": "tax\\s+(document|form|statement|package|information|center)",
      "summary": "Tax Document"
    }
  ],
  "insurance_rules": [
    {
      "pattern": "id\\s+cards?|insurance\\s+cards?|proof\\s+of\\s+insurance",
      "summary": "ID Card"
    },
    {
      "pattern": "declarations?",
      "summary": "Declarations"
    },
    {
      "pattern": "policy\\s+(document|packet|booklet|contract)|\\bpolicy\\b",
      "summary": "Policy Document"
    },
    {
      "pattern": "endorsement|amendment",
      "summary": "Policy Endorsement"
    }
  ],
  "statement_rules": [
    {
      "pattern": "renewal\\s+(notice|bill|statement)",
      "summary": "Renewal Notice"
    },
    {
      "pattern": "payment\\s+receipt|\\breceipt\\b",
      "summary": "Receipt"
    },
    {
      "pattern": "monthly\\s+(account\\s+)?statement",
      "summary": "Monthly Statement"
    },
    {
      "pattern": "\\bstatement\\b",
      "summary": "Statement"
    },
    {
      "pattern": "\\bbills?\\b|billing\\s+notice|premium\\s+notice",
      "summary": "Bill"
    }
  ],
  "skip_patterns": [
    "privacy\\s+(notice|policy)",
    "terms\\s+(of\\s+service|and\\s+conditions)",
    "drive\\s+safe",
    "marketing",
    "\\boffers?\\b"
  ]
}
